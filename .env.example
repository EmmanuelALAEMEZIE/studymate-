# GEMMA_API_URL: Public Gradio URL for Google Gemma 4 E2B Instruct (e.g. running in Kaggle)
# Example: https://5d086c7fc6184718a6.gradio.live
GEMMA_API_URL="https://5d086c7fc6184718a6.gradio.live"

# Optional API key / Bearer token if your Gemma inference provider requires authentication
GEMMA_API_KEY=""

# GEMINI_API_KEY: Optional fallback key injected by AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
